{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://r-icl.local/schemas/task-slice.schema.json",
  "title": "TaskSlice (readonly minimal candidate schema)",
  "description": "TS-001 候选最小 Schema。必填字段对齐 02_架构与合同/02_TaskSlice与Handoff合同.md@r2 的 TaskSlice 必需字段清单。additionalProperties=false：本最小合同只建模已声明字段；新字段须走 contract revision。identity 规则：task_slice_id 形如 TS001-IMPL / TS001-VAL（TS1-S-007）。spec_ref 可选，供 TS1-P-001 引用解析检查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "task_slice_id",
    "revision",
    "status",
    "created",
    "updated",
    "authority_ref",
    "intended_worker",
    "handoff_target",
    "attempt_policy",
    "promotion_plan",
    "objective",
    "non_goals",
    "exact_inputs",
    "preconditions",
    "allowed_paths",
    "allowed_tools",
    "expected_outputs",
    "validation_commands",
    "stop_conditions",
    "rollback"
  ],
  "properties": {
    "type": { "const": "task-slice" },
    "task_slice_id": {
      "type": "string",
      "pattern": "^TS[0-9]{3}-(IMPL|VAL)$",
      "description": "identity / TS1-S-007"
    },
    "revision": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["proposed", "ready", "claimed", "running", "submitted", "accepted", "blocked", "failed", "cancelled", "rejected", "superseded"]
    },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "authority_ref": { "type": "string", "minLength": 1 },
    "intended_worker": { "type": "string", "minLength": 1 },
    "handoff_target": { "type": "string", "minLength": 1 },
    "attempt_policy": { "type": "string", "minLength": 1 },
    "spec_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec_id", "version"],
      "properties": {
        "spec_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "description": "可选：指向精确 ExperimentSpec 版本；解析失败即拒绝（TS1-P-001 / INV-004）"
    },
    "promotion_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_location", "target_location", "trigger_conditions", "approval_ref", "write_actor", "sha_recomputation_and_retention", "rollback_gate"],
      "properties": {
        "candidate_location": { "type": "string" },
        "target_location": { "type": "string" },
        "trigger_conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "approval_ref": { "type": "string" },
        "write_actor": { "type": "string" },
        "sha_recomputation_and_retention": { "type": "string" },
        "rollback_gate": { "type": "string" }
      },
      "description": "一等字段：候选位置、目标位置、触发条件、批准指针、写入主体、SHA 复算与留痕、回滚 Gate"
    },
    "objective": { "type": "string", "minLength": 1 },
    "non_goals": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "exact_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "version", "sha256"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "preconditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowed_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "write": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "allowed_tools": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "expected_outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "expected"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stop_conditions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "rollback": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}